# Copy to .env and fill in the values. Never commit .env.

# NestJS API base URL, including the /api prefix. Exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Secret Auth.js uses to sign and encrypt its session cookie. Server-only.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
